{% extends "base.html.twig" %}

{% block title %}Оставить отзыв{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4">
    <div class="w-full max-w-2xl mx-auto">
        {# Хлебные крошки #}
        <div class="mb-6">
            <a href="{{ path('app_recipe_view', {id: recipe.id}) }}" class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Назад к рецепту "{{ recipe.title }}"
            </a>
        </div>

        {# Форма создания отзыва #}
        <div class="bg-white dark:bg-gray-900 rounded-lg shadow-md dark:shadow-lg p-8">
            <div class="mb-6">
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">Оставить отзыв</h1>
                <p class="text-gray-600 dark:text-gray-400">
                    Оцените рецепт "{{ recipe.title }}" и поделитесь своим мнением
                </p>
            </div>

            {# Flash сообщения #}
            {% for message in app.flashes('error') %}
                <div class="mb-6 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-700 text-red-700 dark:text-red-400 px-4 py-3 rounded-lg">
                    {{ message }}
                </div>
            {% endfor %}

            {# Включение формы #}
            {% include 'review/_form.html.twig' with {
                form: form,
                recipeUrl: path('app_recipe_view', {id: recipe.id}),
                submitButtonText: 'Отправить отзыв'
            } %}
        </div>

        {# Информация о рецепте (справочная) #}
        <div class="mt-6 bg-gray-50 dark:bg-gray-800 rounded-lg p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{{ recipe.title }}</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">
                Автор: {{ recipe.user.name }}
            </p>
            <div class="flex items-center gap-4 text-sm text-gray-600 dark:text-gray-400">
                <div class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    {{ recipe.cookingTime }} мин
                </div>
                <div class="flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    {{ recipe.servings }} {{ recipe.servings == 1 ? 'порция' : (recipe.servings < 5 ? 'порции' : 'порций') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
