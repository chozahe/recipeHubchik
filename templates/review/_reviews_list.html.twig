{# Partial для отображения списка всех отзывов рецепта #}
<div class="mt-12">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
            Отзывы
            {% if reviews|length > 0 %}
                <span class="text-gray-500 dark:text-gray-400 text-2xl">({{ reviews|length }})</span>
            {% endif %}
        </h2>

        {% if canUserReview %}
            <a href="{{ path('app_review_create', {id: recipe.id}) }}"
               class="inline-flex items-center gap-2 bg-blue-600 dark:bg-blue-500 text-white px-5 py-2.5 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors font-medium">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Оставить отзыв
            </a>
        {% endif %}
    </div>

    {% if reviews|length > 0 %}
        <div class="space-y-4">
            {% for review in reviews %}
                {% include 'review/_review_item.html.twig' with {review: review} %}
            {% endfor %}
        </div>
    {% else %}
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-12 text-center border border-gray-200 dark:border-gray-700">
            <svg class="w-16 h-16 text-gray-400 dark:text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
            </svg>
            <h3 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-2">Пока нет отзывов</h3>
            <p class="text-gray-500 dark:text-gray-400 mb-4">
                Будьте первым, кто оставит отзыв об этом рецепте
            </p>
            {% if canUserReview %}
                <a href="{{ path('app_review_create', {id: recipe.id}) }}"
                   class="inline-flex items-center gap-2 bg-blue-600 dark:bg-blue-500 text-white px-5 py-2.5 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors font-medium">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Оставить первый отзыв
                </a>
            {% endif %}
        </div>
    {% endif %}
</div>
