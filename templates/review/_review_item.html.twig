{# Partial для отображения одного отзыва #}
<div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6 border border-gray-200 dark:border-gray-700">
    <div class="flex justify-between items-start mb-3">
        <div class="flex-1">
            <div class="flex items-center gap-3 mb-2">
                <h4 class="text-lg font-semibold text-gray-900 dark:text-white">{{ review.user.name }}</h4>
                <div class="flex items-center gap-1">
                    {% for i in 1..5 %}
                        {% if i <= review.rating %}
                            <svg class="w-5 h-5 text-yellow-400 dark:text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                        {% else %}
                            <svg class="w-5 h-5 text-gray-300 dark:text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            <p class="text-sm text-gray-500 dark:text-gray-400">
                {{ review.createdAt|date('d.m.Y в H:i') }}
                {% if review.updatedAt > review.createdAt %}
                    <span class="ml-2">(обновлено {{ review.updatedAt|date('d.m.Y в H:i') }})</span>
                {% endif %}
            </p>
        </div>

        {% if is_granted('REVIEW_EDIT', review) %}
            <div class="flex gap-2">
                <a href="{{ path('app_review_edit', {id: review.id}) }}"
                   class="text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 transition-colors p-1"
                   title="Редактировать">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                </a>

                {% if is_granted('REVIEW_DELETE', review) %}
                    <form method="post"
                          action="{{ path('app_review_delete', {id: review.id}) }}"
                          onsubmit="return confirm('Вы уверены, что хотите удалить этот отзыв?');"
                          class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-review-' ~ review.id) }}">
                        <button type="submit"
                                class="text-red-600 dark:text-red-400 hover:text-red-800 dark:hover:text-red-300 transition-colors p-1"
                                title="Удалить">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                        </button>
                    </form>
                {% endif %}
            </div>
        {% endif %}
    </div>

    {% if review.comment %}
        <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{{ review.comment }}</p>
    {% endif %}
</div>
