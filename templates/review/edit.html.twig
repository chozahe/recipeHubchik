{% extends "base.html.twig" %}

{% block title %}Редактировать отзыв{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4">
    <div class="w-full max-w-2xl mx-auto">
        {# Хлебные крошки #}
        <div class="mb-6">
            <a href="{{ path('app_recipe_view', {id: review.recipe.id}) }}" class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Назад к рецепту "{{ review.recipe.title }}"
            </a>
        </div>

        {# Форма редактирования отзыва #}
        <div class="bg-white dark:bg-gray-900 rounded-lg shadow-md dark:shadow-lg p-8">
            <div class="mb-6">
                <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">Редактировать отзыв</h1>
                <p class="text-gray-600 dark:text-gray-400">
                    Обновите свой отзыв о рецепте "{{ review.recipe.title }}"
                </p>
            </div>

            {# Flash сообщения #}
            {% for message in app.flashes('error') %}
                <div class="mb-6 bg-red-100 dark:bg-red-900/30 border border-red-400 dark:border-red-700 text-red-700 dark:text-red-400 px-4 py-3 rounded-lg">
                    {{ message }}
                </div>
            {% endfor %}

            {# Включение формы #}
            {% include 'review/_form.html.twig' with {
                form: form,
                recipeUrl: path('app_recipe_view', {id: review.recipe.id}),
                submitButtonText: 'Сохранить изменения'
            } %}
        </div>

        {# Информация об отзыве #}
        <div class="mt-6 bg-gray-50 dark:bg-gray-800 rounded-lg p-6 border border-gray-200 dark:border-gray-700">
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{{ review.recipe.title }}</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">
                        Автор рецепта: {{ review.recipe.user.name }}
                    </p>
                    <div class="text-sm text-gray-500 dark:text-gray-400">
                        Отзыв создан: {{ review.createdAt|date('d.m.Y в H:i') }}
                        {% if review.updatedAt > review.createdAt %}
                            <br>
                            Последнее обновление: {{ review.updatedAt|date('d.m.Y в H:i') }}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
