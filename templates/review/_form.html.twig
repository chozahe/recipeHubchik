{# Partial формы отзыва с интерактивными звездами #}
{{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

    <div data-controller="star-rating">
        {# Рейтинг #}
        <div class="mb-2">
            {{ form_label(form.rating, 'Оцените рецепт', {'label_attr': {'class': 'block text-sm font-semibold text-gray-900 dark:text-white mb-3'}}) }}
        </div>

        {# Скрытые radio buttons для рейтинга #}
        <div data-star-rating-target="radioGroup" class="hidden">
            {{ form_widget(form.rating) }}
        </div>

        {# Интерактивные звезды #}
        <div class="flex items-center gap-2 mb-6">
            {% for i in 1..5 %}
                <button type="button"
                        data-star-rating-target="star"
                        data-rating="{{ i }}"
                        data-action="click->star-rating#selectRating"
                        class="transition-colors duration-200 cursor-pointer hover:scale-110 transform text-gray-300 dark:text-gray-600"
                        title="{{ i }} {{ i == 1 ? 'звезда' : (i < 5 ? 'звезды' : 'звезд') }}">
                    <svg class="w-10 h-10" viewBox="0 0 20 20" stroke="currentColor" stroke-width="1">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" fill="none"/>
                    </svg>
                </button>
            {% endfor %}
        </div>

        {{ form_errors(form.rating, {'attr': {'class': 'text-red-600 dark:text-red-400 text-sm mt-1'}}) }}
    </div>

    {# Комментарий #}
    <div>
        {{ form_label(form.comment, 'Ваш отзыв', {'label_attr': {'class': 'block text-sm font-semibold text-gray-900 dark:text-white mb-2'}}) }}
        {{ form_widget(form.comment, {
            'attr': {
                'class': 'w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent transition-all resize-y min-h-[120px]',
                'placeholder': 'Поделитесь своими впечатлениями о рецепте...',
                'rows': 5
            }
        }) }}
        {{ form_errors(form.comment, {'attr': {'class': 'text-red-600 dark:text-red-400 text-sm mt-1'}}) }}
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">
            Расскажите, что вам понравилось или что можно улучшить
        </p>
    </div>

    {# CSRF token #}
    {{ form_rest(form) }}

    {# Кнопки отправки и отмены #}
    <div class="flex gap-3 mt-8">
        <button type="submit"
                class="flex-1 bg-blue-600 dark:bg-blue-500 text-white px-6 py-3 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-600 transition-colors font-medium flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            {{ submitButtonText|default('Отправить отзыв') }}
        </button>
        <a href="{{ recipeUrl }}"
           class="px-6 py-3 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors font-medium">
            Отмена
        </a>
    </div>

{{ form_end(form, {'render_rest': false}) }}
