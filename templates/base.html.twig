<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}RecipeHub{% endblock %}</title>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
<body class="bg-gray-50 dark:bg-gray-950 flex flex-col min-h-screen">
    <!-- Header -->
    <header class="bg-white dark:bg-gray-900 shadow-sm border-b border-gray-200 dark:border-gray-800">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex justify-between items-center">
                <div class="flex items-center space-x-8">
                    <a href="/" class="flex items-center space-x-2">
                        <span class="text-2xl font-bold text-orange-600 dark:text-orange-500">🍳</span>
                        <span class="text-2xl font-bold text-gray-900 dark:text-white">RecipeHub</span>
                    </a>
                    <div class="hidden md:flex space-x-6">
                        <a href="/" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 dark:hover:text-orange-400 transition">Главная</a>
                        <a href="/recipes" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 dark:hover:text-orange-400 transition">Рецепты</a>
                        {% if app.user %}
                            <a href="/recipes/my" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 dark:hover:text-orange-400 transition">Мои рецепты</a>
                        {% endif %}
                    </div>
                </div>
                <div class="flex items-center space-x-4">
                    {% if app.user %}
                        <span class="text-gray-700 dark:text-gray-300">{{ app.user.email }}</span>
                        <a href="/logout" class="bg-orange-600 hover:bg-orange-700 dark:bg-orange-500 dark:hover:bg-orange-600 text-white px-4 py-2 rounded-lg transition">Выход</a>
                    {% else %}
                        <a href="/login" class="text-gray-700 dark:text-gray-300 hover:text-orange-600 dark:hover:text-orange-400 transition">Вход</a>
                        <a href="/register" class="bg-orange-600 hover:bg-orange-700 dark:bg-orange-500 dark:hover:bg-orange-600 text-white px-4 py-2 rounded-lg transition">Регистрация</a>
                    {% endif %}
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
        {% block body %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 mt-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                <div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-4">RecipeHub</h3>
                    <p class="text-gray-600 dark:text-gray-400">Ваш личный помощник в приготовлении любимых блюд</p>
                </div>
                <div>
                    <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-4">Навигация</h4>
                    <ul class="space-y-2">
                        <li><a href="/" class="text-gray-600 dark:text-gray-400 hover:text-orange-600 dark:hover:text-orange-400 transition">Главная</a></li>
                        <li><a href="/recipes" class="text-gray-600 dark:text-gray-400 hover:text-orange-600 dark:hover:text-orange-400 transition">Все рецепты</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-4">Аккаунт</h4>
                    <ul class="space-y-2">
                        {% if app.user %}
                            <li><a href="/recipes/my" class="text-gray-600 dark:text-gray-400 hover:text-orange-600 dark:hover:text-orange-400 transition">Мои рецепты</a></li>
                            <li><a href="/logout" class="text-gray-600 dark:text-gray-400 hover:text-orange-600 dark:hover:text-orange-400 transition">Выход</a></li>
                        {% else %}
                            <li><a href="/login" class="text-gray-600 dark:text-gray-400 hover:text-orange-600 dark:hover:text-orange-400 transition">Вход</a></li>
                            <li><a href="/register" class="text-gray-600 dark:text-gray-400 hover:text-orange-600 dark:hover:text-orange-400 transition">Регистрация</a></li>
                        {% endif %}
                    </ul>
                </div>
                <div>
                    <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-4">О нас</h4>
                    <p class="text-gray-600 dark:text-gray-400 text-sm">RecipeHub - это сервис для любителей готовить и делиться своими рецептами</p>
                </div>
            </div>
            <div class="border-t border-gray-200 dark:border-gray-800 pt-8">
                <p class="text-center text-gray-600 dark:text-gray-400 text-sm">&copy; 2024 RecipeHub. Все права защищены.</p>
            </div>
        </div>
    </footer>
</body>
</html>
