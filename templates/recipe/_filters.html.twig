<div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg dark:shadow-2xl p-6 mb-6 border border-gray-100 dark:border-gray-800">
    <div class="flex items-center gap-3 mb-6">
        <div class="p-2 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-lg">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
            </svg>
        </div>
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Фильтры и сортировка</h2>
    </div>

    <form method="get" action="{{ path('app_recipes_list') }}" class="space-y-5">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            {# Поиск по названию #}
            <div class="group">
                <label for="filter-name" class="flex items-center gap-2 text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
                    <svg class="w-4 h-4 text-purple-500 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                    Поиск по названию
                </label>
                <div class="relative">
                    <input
                        type="text"
                        id="filter-name"
                        name="name"
                        value="{{ app.request.query.get('name') }}"
                        placeholder="Например: пицца"
                        class="w-full px-4 py-2.5 pl-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white transition-all placeholder:text-gray-400 dark:placeholder:text-gray-500"
                    >
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 dark:text-gray-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                    </svg>
                </div>
            </div>

            {# Сортировка #}
            <div class="group">
                <label for="filter-sort" class="flex items-center gap-2 text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
                    <svg class="w-4 h-4 text-blue-500 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"/>
                    </svg>
                    Сортировка
                </label>
                <div class="relative">
                    <select
                        id="filter-sort"
                        name="sort"
                        class="w-full px-4 py-2.5 pl-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white appearance-none cursor-pointer transition-all bg-white dark:bg-gray-800"
                    >
                        {% set currentSort = app.request.query.get('sort', 'created_desc') %}
                        <option value="created_desc" {% if currentSort == 'created_desc' %}selected{% endif %}>По дате (новые первые)</option>
                        <option value="created_asc" {% if currentSort == 'created_asc' %}selected{% endif %}>По дате (старые первые)</option>
                        <option value="rating_desc" {% if currentSort == 'rating_desc' %}selected{% endif %}>По рейтингу (высокий → низкий)</option>
                        <option value="rating_asc" {% if currentSort == 'rating_asc' %}selected{% endif %}>По рейтингу (низкий → высокий)</option>
                        <option value="name_asc" {% if currentSort == 'name_asc' %}selected{% endif %}>По названию (А-Я)</option>
                        <option value="name_desc" {% if currentSort == 'name_desc' %}selected{% endif %}>По названию (Я-А)</option>
                    </select>
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 dark:text-gray-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"/>
                    </svg>
                    <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 dark:text-gray-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </div>
            </div>

            {# Минимальный рейтинг #}
            <div class="group">
                <label for="filter-rating" class="flex items-center gap-2 text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
                    <svg class="w-4 h-4 text-yellow-500 dark:text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    Минимальный рейтинг
                </label>
                <div class="relative">
                    <select
                        id="filter-rating"
                        name="min_rating"
                        class="w-full px-4 py-2.5 pl-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white appearance-none cursor-pointer transition-all bg-white dark:bg-gray-800"
                    >
                        {% set currentRating = app.request.query.get('min_rating') %}
                        <option value="">Любой рейтинг</option>
                        <option value="4.5" {% if currentRating == '4.5' %}selected{% endif %}>★★★★★ 4.5+</option>
                        <option value="4.0" {% if currentRating == '4.0' %}selected{% endif %}>★★★★☆ 4.0+</option>
                        <option value="3.0" {% if currentRating == '3.0' %}selected{% endif %}>★★★☆☆ 3.0+</option>
                        <option value="2.0" {% if currentRating == '2.0' %}selected{% endif %}>★★☆☆☆ 2.0+</option>
                    </select>
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 dark:text-gray-500 pointer-events-none" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 dark:text-gray-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </div>
            </div>

            {# Ингредиенты (с автодополнением) #}
            <div
                data-controller="ingredient-autocomplete"
                class="md:col-span-2 lg:col-span-3 group"
            >
                <label for="filter-ingredient-input" class="flex items-center gap-2 text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
                    <svg class="w-4 h-4 text-orange-500 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    Ингредиенты
                </label>

                {# Список выбранных ингредиентов #}
                <div
                    data-ingredient-autocomplete-target="selectedList"
                    class="mb-3 flex flex-wrap gap-2 min-h-[2rem]"
                ></div>

                {# Поле ввода для поиска #}
                <div class="relative">
                    <input
                        type="text"
                        id="filter-ingredient-input"
                        data-ingredient-autocomplete-target="input"
                        data-action="input->ingredient-autocomplete#onInput keydown->ingredient-autocomplete#onKeydown"
                        placeholder="Начните вводить название ингредиента"
                        autocomplete="off"
                        class="w-full px-4 py-2.5 pl-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white transition-all placeholder:text-gray-400 dark:placeholder:text-gray-500"
                    >
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 dark:text-gray-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>

                    {# Выпадающий список результатов #}
                    <div
                        data-ingredient-autocomplete-target="dropdown"
                        class="absolute z-10 w-full mt-1 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg shadow-xl max-h-60 overflow-y-auto hidden"
                    ></div>
                </div>

                {# Скрытые поля для отправки ID ингредиентов #}
                <div data-ingredient-autocomplete-target="hiddenContainer">
                    {% for ingredientId in app.request.query.all('ingredients') %}
                        <input type="hidden" name="ingredients[]" value="{{ ingredientId }}">
                    {% endfor %}
                </div>
            </div>

            {# Автор (с автодополнением) #}
            <div
                data-controller="author-autocomplete"
                class="relative group"
            >
                <label for="filter-author-input" class="flex items-center gap-2 text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
                    <svg class="w-4 h-4 text-green-500 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    Автор рецепта
                </label>
                <div class="relative">
                    <input
                        type="text"
                        id="filter-author-input"
                        data-author-autocomplete-target="input"
                        data-action="input->author-autocomplete#onInput keydown->author-autocomplete#onKeydown"
                        placeholder="Начните вводить имя автора"
                        autocomplete="off"
                        class="w-full px-4 py-2.5 pl-10 pr-10 border border-gray-300 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-800 dark:text-white transition-all placeholder:text-gray-400 dark:placeholder:text-gray-500"
                    >
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 dark:text-gray-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    <button
                        type="button"
                        data-author-autocomplete-target="clearButton"
                        data-action="click->author-autocomplete#clearSelection"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-500 dark:hover:text-red-400 transition-colors hidden"
                        title="Очистить"
                    >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
                {# Скрытое поле для отправки ID автора #}
                <input
                    type="hidden"
                    name="author"
                    data-author-autocomplete-target="hiddenId"
                    value="{{ app.request.query.get('author') }}"
                >
                {# Выпадающий список результатов #}
                <div
                    data-author-autocomplete-target="dropdown"
                    class="absolute z-10 w-full mt-1 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-lg shadow-xl max-h-60 overflow-y-auto hidden"
                ></div>
            </div>
        </div>

        <div class="flex flex-wrap gap-3 pt-2 border-t border-gray-200 dark:border-gray-700 mt-2">
            <button
                type="submit"
                class="inline-flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 dark:from-blue-600 dark:to-indigo-600 dark:hover:from-blue-700 dark:hover:to-indigo-700 text-white rounded-lg font-semibold shadow-md hover:shadow-lg transition-all transform hover:scale-105"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
                </svg>
                Применить фильтры
            </button>
            <a
                href="{{ path('app_recipes_list') }}"
                class="inline-flex items-center gap-2 px-6 py-2.5 bg-white dark:bg-gray-800 border-2 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 hover:border-gray-400 dark:hover:border-gray-500 font-semibold shadow-sm hover:shadow transition-all"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Сбросить
            </a>
        </div>
    </form>
</div>

{# JavaScript для инициализации автодополнения автора при загрузке страницы #}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const authorIdField = document.querySelector('[data-author-autocomplete-target="hiddenId"]');
    const authorInputField = document.querySelector('[data-author-autocomplete-target="input"]');
    const clearButton = document.querySelector('[data-author-autocomplete-target="clearButton"]');

    // Если есть выбранный автор (из query параметра), загружаем его имя
    if (authorIdField && authorInputField && authorIdField.value) {
        const authorId = authorIdField.value;

        // Загружаем имя автора через API
        fetch(`/api/users/search?q=&id=${authorId}`, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(users => {
            if (users.length > 0) {
                const author = users[0];
                authorInputField.value = author.name;
                authorInputField.dataset.selectedName = author.name;
                if (clearButton) {
                    clearButton.classList.remove('hidden');
                }
            }
        })
        .catch(error => {
            console.error('Failed to load author name:', error);
            // Оставляем ID в скрытом поле, но показываем ID в видимом поле
            authorInputField.value = `ID: ${authorId}`;
        });
    }
});
</script>
