{% extends "base.html.twig" %}

{% block title %}Редактировать рецепт{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4">
    <div class="w-full max-w-4xl mx-auto">
        <div class="bg-white dark:bg-gray-900 rounded-lg shadow-md dark:shadow-lg p-8">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">Редактировать рецепт</h1>
            <p class="text-gray-600 dark:text-gray-400 mb-6">Обновите информацию о рецепте</p>

            {% for error in app.flashes('error') %}
                <div class="bg-red-50 dark:bg-red-900 border border-red-200 dark:border-red-700 rounded-lg p-4 mb-6">
                    <p class="text-red-800 dark:text-red-200">{{ error }}</p>
                </div>
            {% endfor %}

            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}

                <div>
                    {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    {{ form_widget(form.title) }}
                    {{ form_errors(form.title) }}
                </div>

                <div>
                    {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        {{ form_label(form.servings, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                        {{ form_widget(form.servings) }}
                        {{ form_errors(form.servings) }}
                    </div>

                    <div>
                        {{ form_label(form.cookingTime, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300'}}) }}
                        {{ form_widget(form.cookingTime) }}
                        {{ form_errors(form.cookingTime) }}
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                        Ингредиенты
                    </label>

                    <div id="ingredients-container" class="space-y-3" data-prototype="{{ form_widget(form.ingredients.vars.prototype)|e('html_attr') }}" data-index="{{ form.ingredients|length }}">
                        {% for ingredient in form.ingredients %}
                            <div class="ingredient-item bg-gray-50 dark:bg-gray-800 p-4 rounded-lg">
                                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-start">
                                    <div class="md:col-span-5">
                                        {{ form_widget(ingredient.ingredientName) }}
                                        {{ form_errors(ingredient.ingredientName) }}
                                    </div>
                                    <div class="md:col-span-3">
                                        {{ form_widget(ingredient.quantity) }}
                                        {{ form_errors(ingredient.quantity) }}
                                    </div>
                                    <div class="md:col-span-3">
                                        {{ form_widget(ingredient.unit) }}
                                        {{ form_errors(ingredient.unit) }}
                                    </div>
                                    <div class="md:col-span-1 flex items-center">
                                        <button type="button" onclick="removeIngredient(this)" class="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <button type="button" onclick="addIngredient()" class="mt-3 w-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 py-2 px-4 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 font-medium transition">
                        + Добавить ингредиент
                    </button>

                    {{ form_errors(form.ingredients) }}
                </div>

                <div>
                    {{ form_label(form.recipe, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2'}}) }}
                    {{ form_widget(form.recipe) }}
                    {{ form_errors(form.recipe) }}
                </div>

                <div class="flex gap-4">
                    <button type="submit" class="flex-1 bg-blue-600 dark:bg-blue-700 text-white py-3 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 font-semibold">
                        Сохранить изменения
                    </button>
                    <a href="{{ path('app_recipes_my') }}" class="flex-1 bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 py-3 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 font-semibold text-center">
                        Отмена
                    </a>
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>

<script>
const container = document.getElementById('ingredients-container');
let ingredientIndex = parseInt(container.dataset.index);

function addIngredient() {
    const prototype = container.dataset.prototype;
    const newForm = prototype.replace(/__name__/g, ingredientIndex);

    const wrapper = document.createElement('div');
    wrapper.className = 'ingredient-item bg-gray-50 dark:bg-gray-800 p-4 rounded-lg';

    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = newForm;

    const fields = tempDiv.querySelectorAll('input, select');
    const nameField = fields[0];
    const quantityField = fields[1];
    const unitField = fields[2];

    wrapper.innerHTML = `
        <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-start">
            <div class="md:col-span-5">
                ${nameField.outerHTML}
            </div>
            <div class="md:col-span-3">
                ${quantityField.outerHTML}
            </div>
            <div class="md:col-span-3">
                ${unitField.outerHTML}
            </div>
            <div class="md:col-span-1 flex items-center">
                <button type="button" onclick="removeIngredient(this)" class="text-red-600 hover:text-red-800 dark:text-red-400 dark:hover:text-red-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </div>
    `;

    container.appendChild(wrapper);
    ingredientIndex++;
}

function removeIngredient(button) {
    button.closest('.ingredient-item').remove();
}
</script>
{% endblock %}
