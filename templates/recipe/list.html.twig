{% extends "base.html.twig" %}

{% block title %}Все рецепты{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4">
    <div class="w-full max-w-6xl mx-auto">
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-2">Все рецепты</h1>
            <p class="text-gray-600 dark:text-gray-400">
                Изучайте и готовьте вместе с сообществом
                {% if totalRecipes > 0 %}
                    • Найдено рецептов: {{ totalRecipes }}
                    {% if currentFilter and not currentFilter.isEmpty %}
                        <span class="text-blue-600 dark:text-blue-400">(с фильтрами)</span>
                    {% endif %}
                {% endif %}
            </p>
        </div>

        {# Форма фильтров #}
        {% include 'recipe/_filters.html.twig' %}

        {# Активные фильтры #}
        {% include 'recipe/_active_filters.html.twig' %}

        {% if recipes is empty %}
            <div class="bg-white dark:bg-gray-900 rounded-lg shadow-md dark:shadow-lg p-12 text-center">
                <svg class="w-24 h-24 mx-auto text-gray-400 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Пока нет рецептов</h3>
                <p class="text-gray-600 dark:text-gray-400 mb-6">Станьте первым, кто поделится рецептом!</p>
                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <a href="{{ path('app_recipe_create') }}" class="inline-block bg-blue-600 dark:bg-blue-700 text-white px-6 py-3 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 font-semibold transition">
                        Создать рецепт
                    </a>
                {% endif %}
            </div>
        {% else %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                {% for recipe in recipes %}
                    <div class="bg-white dark:bg-gray-900 rounded-lg shadow-md dark:shadow-lg overflow-hidden hover:shadow-xl dark:hover:shadow-2xl transition">
                        <div class="p-6">
                            <div class="flex items-start justify-between mb-2">
                                <h3 class="text-xl font-bold text-gray-900 dark:text-white flex-1">
                                    {{ recipe.title }}
                                </h3>
                            </div>

                            <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
                                {{ recipe.user.name }} • {{ recipe.createdAt|date('d.m.Y') }}
                            </p>

                            <div class="flex items-center gap-1 mb-4">
                                {% if recipe.averageRating is not null %}
                                    {% for i in 1..5 %}
                                        {% if i <= recipe.averageRating %}
                                            <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                            </svg>
                                        {% else %}
                                            <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                            </svg>
                                        {% endif %}
                                    {% endfor %}
                                    <span class="text-sm text-gray-600 dark:text-gray-400 ml-1">{{ recipe.averageRating|number_format(1, '.') }}</span>
                                {% else %}
                                    {% for i in 1..5 %}
                                        <svg class="w-4 h-4 text-gray-300 dark:text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                        </svg>
                                    {% endfor %}
                                {% endif %}
                            </div>

                            {% if recipe.description %}
                                <p class="text-gray-600 dark:text-gray-400 text-sm mb-4 line-clamp-2">
                                    {{ recipe.description }}
                                </p>
                            {% endif %}

                            <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400 mb-4">
                                <div class="flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    {{ recipe.cookingTime }} мин
                                </div>
                                <div class="flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                                    </svg>
                                    {{ recipe.servings }}
                                </div>
                            </div>

                            <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400 mb-4">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                                </svg>
                                {{ recipe.recipeIngredients|length }} {{ recipe.recipeIngredients|length == 1 ? 'ингредиент' : 'ингредиентов' }}
                            </div>

                            <a href="{{ path('app_recipe_view', {id: recipe.id}) }}" class="block w-full bg-blue-600 dark:bg-blue-700 text-white text-center py-2 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 font-medium transition">
                                Посмотреть рецепт
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {% if totalPages > 1 %}
                {# Макрос для генерации URL с сохранением фильтров #}
                {% macro paginationUrl(page) %}
                    {% set currentQuery = app.request.query.all|merge({'page': page}) %}
                    {{ path('app_recipes_list', currentQuery) }}
                {% endmacro %}
                {% import _self as helpers %}

                <div class="flex justify-center items-center gap-2">
                    {% if hasPrevPage %}
                        <a href="{{ helpers.paginationUrl(currentPage - 1) }}" class="px-4 py-2 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition shadow-md dark:shadow-lg">
                            ← Назад
                        </a>
                    {% else %}
                        <span class="px-4 py-2 bg-gray-200 dark:bg-gray-800 text-gray-400 dark:text-gray-600 rounded-lg cursor-not-allowed">
                            ← Назад
                        </span>
                    {% endif %}

                    <div class="flex items-center gap-2">
                        {% for page in 1..totalPages %}
                            {% if page == currentPage %}
                                <span class="px-4 py-2 bg-blue-600 dark:bg-blue-700 text-white rounded-lg font-semibold shadow-md dark:shadow-lg">
                                    {{ page }}
                                </span>
                            {% elseif page == 1 or page == totalPages or (page >= currentPage - 2 and page <= currentPage + 2) %}
                                <a href="{{ helpers.paginationUrl(page) }}" class="px-4 py-2 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition shadow-md dark:shadow-lg">
                                    {{ page }}
                                </a>
                            {% elseif page == currentPage - 3 or page == currentPage + 3 %}
                                <span class="text-gray-500 dark:text-gray-400">...</span>
                            {% endif %}
                        {% endfor %}
                    </div>

                    {% if hasNextPage %}
                        <a href="{{ helpers.paginationUrl(currentPage + 1) }}" class="px-4 py-2 bg-white dark:bg-gray-900 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition shadow-md dark:shadow-lg">
                            Вперед →
                        </a>
                    {% else %}
                        <span class="px-4 py-2 bg-gray-200 dark:bg-gray-800 text-gray-400 dark:text-gray-600 rounded-lg cursor-not-allowed">
                            Вперед →
                        </span>
                    {% endif %}
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}
