{% extends "base.html.twig" %}

{% block title %}{{ recipe.title }}{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4">
    <div class="w-full max-w-4xl mx-auto">
        <div class="mb-6">
            <a href="{{ path('app_recipes_my') }}" class="text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Назад к рецептам
            </a>
        </div>

        <div class="bg-white dark:bg-gray-900 rounded-lg shadow-md dark:shadow-lg p-8">
            <div class="flex justify-between items-start mb-6">
                <div class="flex-1">
                    <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-2">{{ recipe.title }}</h1>
                    <p class="text-gray-600 dark:text-gray-400 mb-3">
                        Автор: {{ recipe.user.name }} • {{ recipe.createdAt|date('d.m.Y') }}
                    </p>

                    <div class="flex items-center gap-2">
                        {% if recipe.averageRating is not null %}
                            <div class="flex items-center gap-1">
                                {% for i in 1..5 %}
                                    {% if i <= recipe.averageRating %}
                                        <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                        </svg>
                                    {% else %}
                                        <svg class="w-5 h-5 text-gray-300 dark:text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                        </svg>
                                    {% endif %}
                                {% endfor %}
                            </div>
                            <span class="text-gray-700 dark:text-gray-300 font-semibold">{{ recipe.averageRating|number_format(1, '.') }}</span>
                            <span class="text-gray-500 dark:text-gray-400 text-sm">({{ recipe.reviews|length }} {{ recipe.reviews|length == 1 ? 'отзыв' : (recipe.reviews|length < 5 ? 'отзыва' : 'отзывов') }})</span>
                        {% else %}
                            <div class="flex items-center gap-1">
                                {% for i in 1..5 %}
                                    <svg class="w-5 h-5 text-gray-300 dark:text-gray-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                    </svg>
                                {% endfor %}
                            </div>
                            <span class="text-gray-500 dark:text-gray-400 text-sm">Пока нет отзывов</span>
                        {% endif %}
                    </div>
                </div>

                {% if is_granted('RECIPE_EDIT', recipe) %}
                    <div class="flex gap-2">
                        <a href="{{ path('app_recipe_edit', {id: recipe.id}) }}" class="bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 px-4 py-2 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                        </a>
                    </div>
                {% endif %}
            </div>

            {% if recipe.description %}
                <p class="text-gray-700 dark:text-gray-300 text-lg mb-6">{{ recipe.description }}</p>
            {% endif %}

            <div class="flex items-center gap-6 py-4 border-y border-gray-200 dark:border-gray-700 mb-6">
                <div class="flex items-center gap-2 text-gray-700 dark:text-gray-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span class="font-semibold">{{ recipe.cookingTime }} минут</span>
                </div>

                <div class="flex items-center gap-2 text-gray-700 dark:text-gray-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    <span class="font-semibold">{{ recipe.servings }} {{ recipe.servings == 1 ? 'порция' : (recipe.servings < 5 ? 'порции' : 'порций') }}</span>
                </div>
            </div>

            <div class="mb-8">
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Ингредиенты</h2>
                <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6">
                    <ul class="space-y-3">
                        {% for recipeIngredient in recipe.recipeIngredients %}
                            <li class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-blue-600 dark:text-blue-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-gray-700 dark:text-gray-300">
                                    <span class="font-semibold">{{ recipeIngredient.ingredient.name }}</span> —
                                    {{ recipeIngredient.quantity }} {{ recipeIngredient.unit }}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            <div>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Приготовление</h2>
                <div class="prose prose-lg dark:prose-invert max-w-none">
                    <div class="text-gray-700 dark:text-gray-300 whitespace-pre-line">{{ recipe.recipe }}</div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
