{% extends "base.html.twig" %}

{% block title %}Мои рецепты{% endblock %}

{% block body %}
<div class="min-h-screen py-12 px-4">
    <div class="w-full max-w-6xl mx-auto">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-2">Мои рецепты</h1>
                <p class="text-gray-600 dark:text-gray-400">Управляйте своими кулинарными творениями</p>
            </div>
            <a href="{{ path('app_recipe_create') }}" class="bg-blue-600 dark:bg-blue-700 text-white px-6 py-3 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 font-semibold transition">
                + Создать рецепт
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="bg-green-50 dark:bg-green-900 border border-green-200 dark:border-green-700 rounded-lg p-4 mb-6">
                <p class="text-green-800 dark:text-green-200">{{ message }}</p>
            </div>
        {% endfor %}

        {% if recipes is empty %}
            <div class="bg-white dark:bg-gray-900 rounded-lg shadow-md dark:shadow-lg p-12 text-center">
                <svg class="w-24 h-24 mx-auto text-gray-400 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">У вас пока нет рецептов</h3>
                <p class="text-gray-600 dark:text-gray-400 mb-6">Создайте свой первый рецепт и поделитесь им с сообществом</p>
                <a href="{{ path('app_recipe_create') }}" class="inline-block bg-blue-600 dark:bg-blue-700 text-white px-6 py-3 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 font-semibold transition">
                    Создать первый рецепт
                </a>
            </div>
        {% else %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for recipe in recipes %}
                    <div class="bg-white dark:bg-gray-900 rounded-lg shadow-md dark:shadow-lg overflow-hidden hover:shadow-xl dark:hover:shadow-2xl transition">
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">
                                {{ recipe.title }}
                            </h3>

                            {% if recipe.description %}
                                <p class="text-gray-600 dark:text-gray-400 text-sm mb-4 line-clamp-2">
                                    {{ recipe.description }}
                                </p>
                            {% endif %}

                            <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400 mb-4">
                                <div class="flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    {{ recipe.cookingTime }} мин
                                </div>
                                <div class="flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                                    </svg>
                                    {{ recipe.servings }} {{ recipe.servings == 1 ? 'порция' : 'порции' }}
                                </div>
                            </div>

                            <div class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400 mb-4">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                                </svg>
                                {{ recipe.recipeIngredients|length }} {{ recipe.recipeIngredients|length == 1 ? 'ингредиент' : 'ингредиентов' }}
                            </div>

                            <div class="flex gap-2">
                                <a href="{{ path('app_recipe_view', {id: recipe.id}) }}" class="flex-1 bg-blue-600 dark:bg-blue-700 text-white text-center py-2 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 font-medium transition">
                                    Посмотреть
                                </a>
                                <a href="{{ path('app_recipe_edit', {id: recipe.id}) }}" class="bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 px-4 py-2 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </a>
                                <form method="post" action="{{ path('app_recipe_delete', {id: recipe.id}) }}" onsubmit="return confirm('Вы уверены, что хотите удалить этот рецепт?');" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-recipe-' ~ recipe.id) }}">
                                    <button type="submit" class="bg-red-100 dark:bg-red-900 text-red-600 dark:text-red-400 px-4 py-2 rounded-lg hover:bg-red-200 dark:hover:bg-red-800 transition">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
