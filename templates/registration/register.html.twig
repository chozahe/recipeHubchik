{% extends "base.html.twig" %}

{% block title %}Регистрация{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center py-12 px-4">
    <div class="w-full max-w-md">
        <div class="bg-white dark:bg-gray-900 rounded-lg shadow-md dark:shadow-lg p-8">
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">RecipeHub</h1>
            <p class="text-gray-600 dark:text-gray-200 mb-6">Создайте аккаунт</p>

            <turbo-frame id="registration-form">
                {% for error in app.flashes('error') %}
                    <div class="bg-red-50 dark:bg-red-900 border border-red-200 dark:border-red-700 rounded-lg p-4 mb-6">
                        <p class="text-red-800 dark:text-red-200">{{ error }}</p>
                    </div>
                {% endfor %}

                {% for message in app.flashes('success') %}
                    <div class="bg-green-50 dark:bg-green-900 border border-green-200 dark:border-green-700 rounded-lg p-4 mb-6">
                        <p class="text-green-800 dark:text-green-200">{{ message }}</p>
                    </div>
                {% endfor %}

                {{ form_start(form, {'attr': {'class': 'space-y-4', 'novalidate': true, 'data-turbo-frame': formTarget}}) }}

                    <div>
                        {{ form_label(form.email, 'Email') }}
                        {{ form_widget(form.email, {'attr': {'class': 'w-full mt-1 px-3 py-2 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400'}}) }}
                        {% if form.email.vars.errors|length > 0 %}
                            <div class="text-red-600 dark:text-red-400 text-sm mt-1">
                                {% for error in form.email.vars.errors %}
                                    <p>{{ error.message }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div>
                        {{ form_label(form.name, 'Имя') }}
                        {{ form_widget(form.name, {'attr': {'class': 'w-full mt-1 px-3 py-2 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400'}}) }}
                        {% if form.name.vars.errors|length > 0 %}
                            <div class="text-red-600 dark:text-red-400 text-sm mt-1">
                                {% for error in form.name.vars.errors %}
                                    <p>{{ error.message }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <p class="text-gray-500 dark:text-gray-400 text-xs mt-1">Буквы, дефисы, пробелы (2-30 символов)</p>
                    </div>

                    <div>
                        {{ form_label(form.password, 'Пароль') }}
                        {{ form_widget(form.password, {'attr': {'class': 'w-full mt-1 px-3 py-2 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400'}}) }}
                        {% if form.password.vars.errors|length > 0 %}
                            <div class="text-red-600 dark:text-red-400 text-sm mt-1">
                                {% for error in form.password.vars.errors %}
                                    <p>{{ error.message }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <p class="text-gray-500 dark:text-gray-400 text-xs mt-1">8+ символов, буквы и цифры</p>
                    </div>

                    <div>
                        {{ form_label(form.passwordConfirm, 'Подтверждение пароля') }}
                        {{ form_widget(form.passwordConfirm, {'attr': {'class': 'w-full mt-1 px-3 py-2 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400'}}) }}
                        {% if form.passwordConfirm.vars.errors|length > 0 %}
                            <div class="text-red-600 dark:text-red-400 text-sm mt-1">
                                {% for error in form.passwordConfirm.vars.errors %}
                                    <p>{{ error.message }}</p>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    {{ form_widget(form._token) }}

                    <button type="submit" class="w-full bg-blue-600 dark:bg-blue-700 text-white py-2 rounded-lg hover:bg-blue-700 dark:hover:bg-blue-800 font-semibold mt-6">
                        Создать аккаунт
                    </button>

                {{ form_end(form) }}
            </turbo-frame>

            <p class="text-center text-gray-600 dark:text-gray-400 text-sm mt-6">
                Уже есть аккаунт? <a href="{{ path('app_login') }}" class="text-blue-600 dark:text-blue-400 hover:underline">Войти</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
