{% extends 'base.html.twig' %}

{% block title %}RecipeHub - Главная{% endblock %}

{% block body %}
<!-- Hero Section -->
<section class="bg-gradient-to-br from-orange-50 to-amber-50 dark:from-gray-900 dark:to-gray-800 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        {% for message in app.flashes('success') %}
            <div class="bg-green-50 dark:bg-green-900 border border-green-200 dark:border-green-700 rounded-lg p-4 mb-6 max-w-md mx-auto">
                <h2 class="text-lg font-semibold text-green-800 dark:text-green-200 mb-2">Успешно!</h2>
                <p class="text-green-700 dark:text-green-300">{{ message }}</p>
            </div>
        {% endfor %}

        <div class="mb-6">
            <span class="text-6xl">🍳</span>
        </div>
        <h1 class="text-5xl md:text-6xl font-bold text-gray-900 dark:text-white mb-4">
            RecipeHub
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
            Откройте для себя бесконечный мир вкусов. Создавайте, делитесь и наслаждайтесь рецептами со всего мира
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            {% if app.user %}
                <a href="/recipes" class="bg-orange-600 hover:bg-orange-700 dark:bg-orange-500 dark:hover:bg-orange-600 text-white font-semibold px-8 py-3 rounded-lg transition">
                    Смотреть все рецепты
                </a>
                <a href="/recipes/create" class="bg-white dark:bg-gray-800 text-orange-600 dark:text-orange-400 border-2 border-orange-600 dark:border-orange-400 hover:bg-orange-50 dark:hover:bg-gray-700 font-semibold px-8 py-3 rounded-lg transition">
                    Добавить свой рецепт
                </a>
            {% else %}
                <a href="/recipes" class="bg-orange-600 hover:bg-orange-700 dark:bg-orange-500 dark:hover:bg-orange-600 text-white font-semibold px-8 py-3 rounded-lg transition">
                    Смотреть рецепты
                </a>
                <a href="/login" class="bg-white dark:bg-gray-800 text-orange-600 dark:text-orange-400 border-2 border-orange-600 dark:border-orange-400 hover:bg-orange-50 dark:hover:bg-gray-700 font-semibold px-8 py-3 rounded-lg transition">
                    Войти в аккаунт
                </a>
            {% endif %}
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-center text-gray-900 dark:text-white mb-12">
            Почему RecipeHub?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Feature 1 -->
            <div class="bg-white dark:bg-gray-900 rounded-lg p-8 shadow-md dark:shadow-lg hover:shadow-lg dark:hover:shadow-xl transition">
                <div class="text-4xl mb-4">🌟</div>
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">
                    Уникальные рецепты
                </h3>
                <p class="text-gray-600 dark:text-gray-400">
                    Найдите проверенные рецепты от опытных кулинаров и простых любителей готовить
                </p>
            </div>

            <!-- Feature 2 -->
            <div class="bg-white dark:bg-gray-900 rounded-lg p-8 shadow-md dark:shadow-lg hover:shadow-lg dark:hover:shadow-xl transition">
                <div class="text-4xl mb-4">👥</div>
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">
                    Сообщество
                </h3>
                <p class="text-gray-600 dark:text-gray-400">
                    Делитесь своими лучшими рецептами и вдохновляйте других кулинаров
                </p>
            </div>

            <!-- Feature 3 -->
            <div class="bg-white dark:bg-gray-900 rounded-lg p-8 shadow-md dark:shadow-lg hover:shadow-lg dark:hover:shadow-xl transition">
                <div class="text-4xl mb-4">⚡</div>
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">
                    Быстро и удобно
                </h3>
                <p class="text-gray-600 dark:text-gray-400">
                    Легко найдите, создавайте и управляйте своей коллекцией рецептов
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Section -->
{% if not app.user %}
<section class="bg-orange-600 dark:bg-orange-500 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">
            Готовы начать?
        </h2>
        <p class="text-xl text-orange-100 mb-8">
            Присоединяйтесь к нашему сообществу и начните делиться своими рецептами
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/register" class="bg-white hover:bg-orange-50 text-orange-600 dark:text-orange-500 font-semibold px-8 py-3 rounded-lg transition">
                Создать аккаунт
            </a>
            <a href="/login" class="bg-transparent hover:bg-white hover:bg-opacity-20 text-white border-2 border-white font-semibold px-8 py-3 rounded-lg transition">
                Уже есть аккаунт?
            </a>
        </div>
    </div>
</section>
{% endif %}

<!-- Latest Recipes Section -->
<section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center mb-12">
            <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
                Популярные рецепты
            </h2>
            <a href="/recipes" class="text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300 font-semibold">
                Смотреть все →
            </a>
        </div>
        <div class="bg-white dark:bg-gray-900 rounded-lg p-12 shadow-md dark:shadow-lg text-center">
            <p class="text-gray-600 dark:text-gray-400 mb-6">
                Начните с просмотра нашей полной коллекции рецептов
            </p>
            <a href="/recipes" class="inline-block bg-orange-600 hover:bg-orange-700 dark:bg-orange-500 dark:hover:bg-orange-600 text-white font-semibold px-6 py-2 rounded-lg transition">
                Перейти к рецептам
            </a>
        </div>
    </div>
</section>
{% endblock %}
