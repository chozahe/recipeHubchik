{% extends "base.html.twig" %}

{% block title %}Профиль{% endblock %}

{% block body %}
<div class="min-h-screen py-8 sm:py-12 px-4">
    <div class="max-w-5xl mx-auto">
        <!-- Page Header with Breadcrumb -->
        <div class="mb-6">
            <a href="{{ path('app_home') }}" class="text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300 inline-flex items-center gap-2 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                <span class="font-medium">На главную</span>
            </a>
        </div>

        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-8 flex items-center gap-3">
            <span class="text-4xl">👤</span>
            Мой профиль
        </h1>

        <!-- Flash Messages -->
        {% for error in app.flashes('error') %}
            <div class="bg-red-50 dark:bg-red-900/50 border-l-4 border-red-500 dark:border-red-400 rounded-lg p-4 mb-6 shadow-sm animate-fade-in">
                <div class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-red-500 dark:text-red-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                    <p class="text-red-800 dark:text-red-200 font-medium">{{ error }}</p>
                </div>
            </div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div class="bg-green-50 dark:bg-green-900/50 border-l-4 border-green-500 dark:border-green-400 rounded-lg p-4 mb-6 shadow-sm animate-fade-in">
                <div class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-green-500 dark:text-green-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    <p class="text-green-800 dark:text-green-200 font-medium">{{ message }}</p>
                </div>
            </div>
        {% endfor %}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
            <!-- User Information Card -->
            <div class="lg:col-span-1">
                <div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg dark:shadow-2xl overflow-hidden border border-gray-100 dark:border-gray-800 transition-all hover:shadow-xl dark:hover:shadow-2xl">
                    <!-- User Avatar Section -->
                    <div class="bg-gradient-to-br from-orange-500 to-orange-600 dark:from-orange-600 dark:to-orange-700 p-8 text-center">
                        <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-white dark:bg-gray-900 text-orange-600 dark:text-orange-400 text-4xl font-bold shadow-lg mb-4">
                            {{ user.email|first|upper }}
                        </div>
                        <h2 class="text-2xl font-bold text-white mb-1">{{ user.name }}</h2>
                        {% if user.isAdmin %}
                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-semibold bg-purple-100 dark:bg-purple-900/50 text-purple-800 dark:text-purple-200 shadow-sm">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M3 6a3 3 0 013-3h10a1 1 0 01.8 1.6L14.25 8l2.55 3.4A1 1 0 0116 13H6a1 1 0 00-1 1v3a1 1 0 11-2 0V6z" clip-rule="evenodd"/>
                                </svg>
                                Администратор
                            </span>
                        {% else %}
                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-semibold bg-white/90 dark:bg-gray-900/50 text-orange-700 dark:text-orange-300 shadow-sm">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                                </svg>
                                Пользователь
                            </span>
                        {% endif %}
                    </div>

                    <!-- User Details -->
                    <div class="p-6 space-y-5">
                        <!-- Email -->
                        <div class="group">
                            <div class="flex items-center gap-2 text-sm font-semibold text-gray-500 dark:text-gray-400 mb-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                                <span>Email адрес</span>
                            </div>
                            <p class="text-gray-900 dark:text-white font-medium pl-6 break-all">{{ user.email }}</p>
                        </div>

                        <div class="border-t border-gray-100 dark:border-gray-800"></div>

                        <!-- Registration Date -->
                        <div class="group">
                            <div class="flex items-center gap-2 text-sm font-semibold text-gray-500 dark:text-gray-400 mb-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                                <span>Дата регистрации</span>
                            </div>
                            <p class="text-gray-900 dark:text-white font-medium pl-6">
                                <span class="block">{{ user.createdAt|date('d.m.Y') }}</span>
                                <span class="text-sm text-gray-500 dark:text-gray-400">в {{ user.createdAt|date('H:i') }}</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Change Password Card -->
            <div class="lg:col-span-2">
                <div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg dark:shadow-2xl overflow-hidden border border-gray-100 dark:border-gray-800 transition-all hover:shadow-xl dark:hover:shadow-2xl">
                    <!-- Card Header -->
                    <div class="border-b border-gray-100 dark:border-gray-800 px-6 sm:px-8 py-6">
                        <div class="flex items-center gap-3">
                            <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Смена пароля</h2>
                                <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Обновите пароль для вашей учетной записи</p>
                            </div>
                        </div>
                    </div>

                    <!-- Form -->
                    <div class="px-6 sm:px-8 py-8">
                        {{ form_start(changePasswordForm, {'attr': {'class': 'space-y-6'}}) }}

                            <!-- Current Password -->
                            <div class="group">
                                {{ form_label(changePasswordForm.currentPassword, 'Текущий пароль', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg class="w-5 h-5 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                                        </svg>
                                    </div>
                                    {{ form_widget(changePasswordForm.currentPassword, {'attr': {
                                        'class': 'w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 dark:focus:ring-orange-400 focus:border-transparent transition-all',
                                        'placeholder': 'Введите текущий пароль'
                                    }}) }}
                                </div>
                                {% if changePasswordForm.currentPassword.vars.errors|length > 0 %}
                                    <div class="mt-2 space-y-1">
                                        {% for error in changePasswordForm.currentPassword.vars.errors %}
                                            <div class="flex items-start gap-2 text-red-600 dark:text-red-400 text-sm">
                                                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                                                </svg>
                                                <p class="font-medium">{{ error.message }}</p>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="border-t border-gray-100 dark:border-gray-800"></div>

                            <!-- New Password -->
                            <div class="group">
                                {{ form_label(changePasswordForm.newPassword, 'Новый пароль', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg class="w-5 h-5 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                        </svg>
                                    </div>
                                    {{ form_widget(changePasswordForm.newPassword, {'attr': {
                                        'class': 'w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 dark:focus:ring-orange-400 focus:border-transparent transition-all',
                                        'placeholder': 'Введите новый пароль'
                                    }}) }}
                                </div>
                                {% if changePasswordForm.newPassword.vars.errors|length > 0 %}
                                    <div class="mt-2 space-y-1">
                                        {% for error in changePasswordForm.newPassword.vars.errors %}
                                            <div class="flex items-start gap-2 text-red-600 dark:text-red-400 text-sm">
                                                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                                                </svg>
                                                <p class="font-medium">{{ error.message }}</p>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <div class="mt-2 flex items-start gap-2 text-gray-500 dark:text-gray-400 text-xs">
                                        <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                                        </svg>
                                        <p>Пароль должен содержать минимум 6 символов</p>
                                    </div>
                                {% endif %}
                            </div>

                            <!-- Confirm Password -->
                            <div class="group">
                                {{ form_label(changePasswordForm.confirmPassword, 'Подтвердите новый пароль', {'label_attr': {'class': 'block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2'}}) }}
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <svg class="w-5 h-5 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                    </div>
                                    {{ form_widget(changePasswordForm.confirmPassword, {'attr': {
                                        'class': 'w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 dark:focus:ring-orange-400 focus:border-transparent transition-all',
                                        'placeholder': 'Повторите новый пароль'
                                    }}) }}
                                </div>
                                {% if changePasswordForm.confirmPassword.vars.errors|length > 0 %}
                                    <div class="mt-2 space-y-1">
                                        {% for error in changePasswordForm.confirmPassword.vars.errors %}
                                            <div class="flex items-start gap-2 text-red-600 dark:text-red-400 text-sm">
                                                <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                                                </svg>
                                                <p class="font-medium">{{ error.message }}</p>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>

                            {{ form_widget(changePasswordForm._token) }}

                            <!-- Action Buttons -->
                            <div class="flex flex-col sm:flex-row justify-end gap-3 pt-4">
                                <a href="{{ path('app_home') }}"
                                   class="order-2 sm:order-1 px-6 py-3 border-2 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 hover:border-gray-400 dark:hover:border-gray-500 font-semibold transition-all text-center">
                                    Отмена
                                </a>
                                <button type="submit"
                                        class="order-1 sm:order-2 px-6 py-3 bg-gradient-to-r from-orange-600 to-orange-700 dark:from-orange-500 dark:to-orange-600 text-white rounded-lg hover:from-orange-700 hover:to-orange-800 dark:hover:from-orange-600 dark:hover:to-orange-700 font-semibold shadow-lg hover:shadow-xl transition-all transform hover:scale-105">
                                    <span class="flex items-center justify-center gap-2">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                        </svg>
                                        Сменить пароль
                                    </span>
                                </button>
                            </div>

                        {{ form_end(changePasswordForm) }}
                    </div>
                </div>

                <!-- Security Tips Card -->
                <div class="mt-6 bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800 rounded-lg p-5">
                    <div class="flex items-start gap-3">
                        <div class="flex-shrink-0">
                            <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                        <div>
                            <h3 class="font-semibold text-blue-900 dark:text-blue-200 mb-2">Рекомендации по безопасности</h3>
                            <ul class="space-y-1 text-sm text-blue-800 dark:text-blue-300">
                                <li class="flex items-start gap-2">
                                    <span class="text-blue-600 dark:text-blue-400 mt-1">•</span>
                                    <span>Используйте уникальный пароль для каждого сервиса</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-blue-600 dark:text-blue-400 mt-1">•</span>
                                    <span>Комбинируйте буквы, цифры и специальные символы</span>
                                </li>
                                <li class="flex items-start gap-2">
                                    <span class="text-blue-600 dark:text-blue-400 mt-1">•</span>
                                    <span>Не используйте личную информацию в пароле</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
